# Copy to .env — never commit .env

POSTGRES_USER=monza
POSTGRES_PASSWORD=change-me
POSTGRES_DB=monza
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://monza:change-me@127.0.0.1:5433/monza

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=009
BOOTSTRAP_ADMIN_NAME=Администратор
API_HOST=127.0.0.1
API_PORT=8790

# Public HTTP on the shared Debian host is :8083 (80/8081/8082 are taken)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8083,http://localhost:8083
